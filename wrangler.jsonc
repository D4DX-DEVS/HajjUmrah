{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hajj-next",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // `next build` output (output: "export")
    "directory": "./out",
    "binding": "ASSETS",
    // real 404 status with out/404.html
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // only the contact API runs Worker code; pages and images are free static assets
    "run_worker_first": ["/api/*"]
  },
  // contact-form messages (table created by migrations/)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajjumra",
      "database_id": "7f743071-4df2-4f35-a78e-76be82fe33b4",
      "migrations_dir": "migrations"
    }
  ]
}
