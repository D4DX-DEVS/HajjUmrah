{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "hajj-next",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // must match "name" above
      "service": "hajj-next"
    }
  ],
  // contact-form messages (table created by migrations/)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajjumra",
      "database_id": "7f743071-4df2-4f35-a78e-76be82fe33b4",
      "migrations_dir": "migrations"
    }
  ],
  // next/image optimization (Cloudflare Images; may incur cost beyond the free allowance)
  "images": {
    "binding": "IMAGES"
  }
}
