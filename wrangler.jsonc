{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hajj-next",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // vars and secrets show up in process.env
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // worker.ts renders pages through a call to itself (see "Page cache" in the README)
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hajj-next" }],
  // images uploaded in the admin, and the stored copies of rendered pages (cache/)
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hajjumra" }],
  "vars": {
    "SITE_URL": "https://hajj.islamonlive.in",
    // "1": every page is noindex and robots.txt disallows everything (visitors still arrive from the links on islamonlive.in). Remove it, or set "0", to open the site to search engines.
    "NOINDEX": "1",
    // public address of the bucket, used for image previews in the admin
    "MEDIA_URL": "https://pub-c7884d3013394bc9948f3795c715c94a.r2.dev"
  },
  // posts, tags, videos (D1 is the source of truth), contact messages and admin login attempts (migrations/)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajjumra",
      "database_id": "7f743071-4df2-4f35-a78e-76be82fe33b4",
      "migrations_dir": "migrations"
    }
  ],
  // deploy time: a new deploy counts as a purge (worker.ts), so stored pages never name CSS/font files of an old build
  "version_metadata": { "binding": "VERSION" },
  // fills the page cache: renders a few pages nobody has visited yet on every run
  "triggers": { "crons": ["*/5 * * * *"] }
}
