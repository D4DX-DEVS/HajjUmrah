{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hajj-next",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // `next build` output (output: "export")
    "directory": "./out",
    "binding": "ASSETS",
    // real 404 status with out/404.html
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // only the contact API runs Worker code; pages and images are free static assets
    "run_worker_first": ["/api/*"]
  },
  // admin: images go to this bucket, posts are committed to this repo (secrets: ADMIN_PASSWORD, GITHUB_TOKEN)
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hajjumra" }],
  "vars": {
    "GITHUB_REPO": "D4DX-DEVS/HajjUmrah",
    "GITHUB_BRANCH": "main",
    // public address of the bucket, used for image previews in the admin
    "MEDIA_URL": "https://pub-c7884d3013394bc9948f3795c715c94a.r2.dev"
  },
  // contact-form messages and admin login attempts (tables created by migrations/)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajjumra",
      "database_id": "7f743071-4df2-4f35-a78e-76be82fe33b4",
      "migrations_dir": "migrations"
    }
  ]
}
