{
  // Only used by the Wrangler command line for the D1 database (npm run db:migrate / messages).
  // The site itself is hosted on Vercel and reaches D1 and R2 over their HTTP APIs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hajj-next",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajjumra",
      "database_id": "7f743071-4df2-4f35-a78e-76be82fe33b4",
      "migrations_dir": "migrations"
    }
  ]
}
