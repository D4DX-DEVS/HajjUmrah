{
  "name": "hajj-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/strip-env.mjs && node --env-file=.env node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy && node --env-file=.env scripts/purge-cache.mjs",
    "lint": "eslint",
    "db:migrate": "wrangler d1 migrations apply hajjumra --remote",
    "messages": "wrangler d1 execute hajjumra --remote --command \"SELECT id, created_at, name, email, message FROM contact_messages ORDER BY id DESC LIMIT 50\"",
    "db:seed:local": "node scripts/seed-d1.mjs --local",
    "db:seed:remote": "node --env-file=.env scripts/seed-d1.mjs --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  }
}
