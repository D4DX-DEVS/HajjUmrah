{
  "name": "hajj-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply hajjumra --remote",
    "messages": "wrangler d1 execute hajjumra --remote --command \"SELECT id, created_at, name, email, message FROM contact_messages ORDER BY id DESC LIMIT 50\""
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  }
}
